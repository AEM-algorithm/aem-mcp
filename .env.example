PORT=3000
NODE_ENV=development
AEM_BACKEND_URL=http://localhost:3000/api
# Must match aem-backend session JWT secret (dev default is 1234)
JWT_SECRET=1234

# ---- OAuth (DEV-4154) ----
# Shared HMAC secret with aem-backend. Must be >= 32 bytes in production.
# In dev/test a placeholder is auto-generated.
MCP_OAUTH_SIGNING_KEY=

# Set to "false" to short-circuit all /oauth/* routes to 503 (catastrophic
# rollback). Defaults to "true".
OAUTH_ENABLED=true

# aem-backend's exchange endpoint. Used by /oauth/authorize (the form
# that turns email+password into a short-lived exchange code).
MCP_BACKEND_OAUTH_EXCHANGE_URL=http://localhost:3000/api/oauth/exchange

# Backend endpoint that converts MCP access tokens into backend session cookies.
MCP_BACKEND_SESSION_URL=http://localhost:3000/api/oauth/session

# Public base URL used in OAuth discovery metadata. Set to the public HTTPS
# host in staging/production. Required in production; the frontend bridge uses
# it to create the trusted device-binding callback URI.
PUBLIC_URL=http://localhost:3000

# Device authorization signs mcp_state and redirects to the React login page.
# Required in production; MCP_JWT_SECRET must match aem-backend.
MCP_FRONTEND_URL=http://localhost:8000
MCP_JWT_SECRET=replace-with-the-same-random-secret-as-aem-backend

# Optional external MCP servers to expose through this server.
# MCP_EXTERNAL_SERVERS=[{"name":"figma","type":"http","url":"https://mcp.figma.com/mcp"}]

# ---- Rate limits (per IP per 60s) ----
RATE_LIMIT_OAUTH_DEVICE_PER_MIN=5
RATE_LIMIT_OAUTH_TOKEN_PER_MIN=30
