PORT=3000
NODE_ENV=development
AEM_BACKEND_URL=http://localhost:3000/api
# Must match aem-backend session JWT secret (dev default is 1234)
JWT_SECRET=1234

# ---- OAuth (DEV-4154) ----
# Shared HMAC secret with aem-backend. Must be >= 32 bytes in production.
# In dev/test a placeholder is auto-generated.
MCP_OAUTH_SIGNING_KEY=

# Set to "false" to short-circuit all /oauth/* routes to 503 (catastrophic
# rollback). Defaults to "true".
OAUTH_ENABLED=true

# aem-backend's exchange endpoint. Used by /oauth/authorize (the form
# that turns email+password into a short-lived exchange code).
MCP_BACKEND_OAUTH_EXCHANGE_URL=http://localhost:3000/api/oauth/exchange

# ---- Rate limits (per IP per 60s) ----
RATE_LIMIT_OAUTH_DEVICE_PER_MIN=5
RATE_LIMIT_OAUTH_TOKEN_PER_MIN=30
