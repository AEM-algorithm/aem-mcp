{
  "name": "aem-mcp",
  "version": "0.1.0",
  "description": "AEM Journaler MCP server — tool catalog and Streamable HTTP transport for chatbot integration",
  "main": "build/index.js",
  "scripts": {
    "build": "rm -rf ./build && tsc",
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "start": "node -r dotenv/config build/index.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:unit": "jest --runInBand --detectOpenHandles --forceExit tests/unit"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.8.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
