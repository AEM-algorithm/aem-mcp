{
  "name": "aem-mcp",
  "version": "0.1.0",
  "description": "AEM Journaler MCP server — tool catalog and Streamable HTTP transport for chatbot integration",
  "main": "build/index.js",
  "scripts": {
    "build": "rm -rf ./build && tsc",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "security:audit": "npm audit --omit=dev --audit-level=critical",
    "security:audit:high": "npm audit --omit=dev --audit-level=high",
    "security:audit:json": "npm audit --omit=dev --json",
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "start": "node -r dotenv/config build/index.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit tests/unit",
    "test:unit": "jest --runInBand --detectOpenHandles --forceExit tests/unit",
    "test:e2e": "jest --runInBand --detectOpenHandles --forceExit --config jest.e2e.config.js",
    "test:coverage": "jest --runInBand --detectOpenHandles --forceExit --coverage tests/unit",
    "test:coverage:html": "jest --runInBand --detectOpenHandles --forceExit --coverage --coverageReporters=html tests/unit"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.8.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
