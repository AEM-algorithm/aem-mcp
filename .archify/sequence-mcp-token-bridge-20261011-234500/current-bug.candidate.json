  "cards": [
    {
      "dot": "rose",
      "title": "Where it breaks",
      "items": [
        "src/server.ts:213 — authToken = access_token (the bare MCP access token is reused downstream)",
        "src/clients/aem-backend-client.ts — Cookie header is built from that same token",
        "aem-backend expects a session token signed with SESSION_SECRET, not MCP_OAUTH_SIGNING_KEY"
      ]
    },
    {
      "dot": "amber",
      "title": "Why aem-backend rejects",
      "items": [
        "Two different HMAC secrets (MCP_OAUTH_SIGNING_KEY vs SESSION_SECRET / JWT_SECRET=1234)",
        "Two different claim shapes: {sub,aud,jti,scope} vs {id,userEmail,need2FA,...}",
        "JWT signature verify fails on the backend before any DB lookup"
      ]
    },
    {
      "dot": "slate",
      "title": "Scope of impact",
      "items": [
        "Every tool call in /mcp returns {\"error\":\"Unauthorized\"}",
        "Chatbot cookie/session path is unaffected (legacy verifySessionToken path)",
        "OAuth login flow itself is fine; only downstream forwarding is broken"
      ]
    }
  ]
}
